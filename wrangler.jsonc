{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbtsk-26",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cbtsk-26"
    }
  ]
}
